-- Loaded only by verify-digest-capacity.ts after its loopback guard. No external messaging.
begin;
do $$
declare org uuid:='__ORG__'; dtype uuid; role_id uuid;
begin
  if (select count(*) from public.obligations where organization_id='a7070000-0000-4000-8000-000000000001')<>12000 then
    raise exception 'Run the existing H07 local capacity fixture first';
  end if;
  insert into public.organizations(id,name) values(org,'H06 digest capacity Docker');
  update public.organizations set settings=jsonb_set(settings,'{digest_local_time}','"00:00"') where id=org;
  insert into auth.users(id,email) select gen_random_uuid(),'digest-capacity-'||org||'-'||i||'@example.test' from generate_series(1,100) i;
  insert into public.profiles(user_id,email,full_name,provisioning_status,whatsapp_phone)
    select id,email,'Digest capacity Docker','ready','+15005550006' from auth.users where email like 'digest-capacity-'||org||'-%@example.test';
  insert into public.organization_members(organization_id,user_id,member_type)
    select org,user_id,'internal' from public.profiles where email like 'digest-capacity-'||org||'-%@example.test';
  insert into public.permissions(organization_id,module,action,description) select org,'laboral_trabajador',a,a from unnest(array['view','upload']) a;
  insert into public.roles(organization_id,code,name,audience) values(org,'capacity','Capacity','internal') returning id into role_id;
  insert into public.role_permissions(organization_id,role_id,permission_id) select org,role_id,id from public.permissions where organization_id=org;
  insert into public.companies(organization_id,ruc,legal_name,control_start_date)
    select org,'2070600'||lpad(i::text,4,'0'),'Digest capacity company '||i,'2026-01-01' from generate_series(1,30) i;
  insert into public.access_grants(organization_id,member_id,company_id,role_id,scope,module)
    select org,m.id,c.id,role_id,'company','laboral_trabajador' from public.organization_members m cross join public.companies c where m.organization_id=org and c.organization_id=org;
  insert into public.workers(organization_id,company_id,identity_type,identity_number,first_names,last_names)
    select org,c.id,'DNI',lpad(i::text,8,'0'),'Worker '||i,'Digest capacity' from generate_series(1,1000) i
    cross join lateral(select id from public.companies where organization_id=org order by ruc offset ((i-1)%30) limit 1) c;
  insert into public.employment_periods(organization_id,company_id,worker_id,sequence_number,start_date)
    select org,company_id,id,1,'2026-01-01' from public.workers where organization_id=org;
  insert into public.document_types(organization_id,code,name,module) values(org,'digest-capacity','Digest capacity','laboral_trabajador') returning id into dtype;
  insert into public.periods(organization_id,kind,period_key,start_date,end_date)
    select org,'monthly',to_char(d,'YYYY-MM'),d::date,(d+interval '1 month -1 day')::date from generate_series('2026-01-01'::date,'2026-12-01'::date,'1 month') d;
  with recipients as(select user_id,row_number() over(order by user_id) n from public.organization_members where organization_id=org),
    destinations as(select e.id,e.company_id,p.id period,p.period_key,p.end_date,row_number() over(order by e.id,p.id) n
      from public.employment_periods e cross join public.periods p where e.organization_id=org and p.organization_id=org)
  insert into public.obligations(organization_id,class,company_id,employment_period_id,module,period_id,document_type_id,destination_key,occurrence_key,manual_request_id,title,initial_due_date,delivery_responsible_id,snapshot)
    select org,'documentary',d.company_id,d.id,'laboral_trabajador',d.period,dtype,'employment_period:'||d.id,d.period_key,gen_random_uuid(),'Digest capacity '||d.period_key,d.end_date,r.user_id,
      jsonb_build_object('schema_version',1,'module','laboral_trabajador','initial_due_date',d.end_date) from destinations d join recipients r on r.n=((d.n-1)%100)+1;
  insert into public.deliverables(organization_id,obligation_id,position_code,label,display_order) select org,id,'file','File',1 from public.obligations where organization_id=org;
  insert into public.submission_cycles(organization_id,deliverable_id,cycle_number,reason,due_date)
    select org,d.id,1,'initial',o.initial_due_date from public.deliverables d join public.obligations o on o.id=d.obligation_id where d.organization_id=org;
end $$;
commit;
