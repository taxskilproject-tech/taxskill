# Frontend: configuración pública del proyecto Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Servidor: completar antes de activar Auth Admin en H02. Nunca usar NEXT_PUBLIC.
SUPABASE_SECRET_KEY=
IDEMPOTENCY_HMAC_KEY=

# H10: secretos de cifrado solo servidor/worker. No habilitan el conector real.
SUNAT_CREDENTIALS_CURRENT_KEY=
SUNAT_CREDENTIALS_KEYS=
SUNAT_EXECUTION_MODE=local
SUNAT_SOURCE_VALIDATED=false
SUNAT_SANDBOX_IMAGE=
SUNAT_DISPATCH_SECRET=
SUNAT_DAILY_ENABLED=false

# Integración de H06; instalar cada valor en el ejecutor indicado en docs/desarrollo.md.
APP_BASE_URL=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
N8N_RECEIPT_TOKEN=

# Respaldo: solo en el ejecutor de copias, nunca en Vercel ni NEXT_PUBLIC.
H08_BACKUP_DESTINATION=
H08_BACKUP_ENCRYPTION_KEY=
H08_DATABASE_URL=
H08_DATABASE_CA_CERT=
H08_BACKUP_S3_URI=
H08_OPERATION_ORGANIZATION_ID=

# Solo pruebas Docker: omitir usa 3001; alternativa 4001. No importar en Vercel.
# TAXSKILL_LOCAL_APP_PORT=4001
