{
  "name": "tax-skill",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "yarn": "1.22.22"
  },
  "scripts": {
    "dev": "tsx scripts/check-local-environment.ts && tsx scripts/copy-pdf-worker.ts && next dev",
    "build": "tsx scripts/copy-pdf-worker.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:architecture": "tsx scripts/check-project.ts",
    "verify": "yarn typecheck && yarn lint && yarn check:architecture && yarn test",
    "env:setup": "tsx scripts/configure-public-environment.ts",
    "env:local": "tsx scripts/configure-local-environment.ts",
    "db:types": "tsx scripts/generate-database-types.ts",
    "db:new": "supabase migration new",
    "db:status": "supabase migration list --linked",
    "db:local:start": "supabase start",
    "db:local:reset": "supabase db reset --local",
    "env:admin": "tsx scripts/configure-admin-environment.ts",
    "env:vercel": "tsx scripts/export-vercel-environment.ts",
    "auth:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "seed:demo": "tsx scripts/bootstrap-admin.ts --demo",
    "db:lint": "supabase db lint --local --schema public,private --level error --fail-on error",
    "db:lint:cloud": "supabase db lint --linked --schema public,private --level error --fail-on error",
    "test:h02:sql": "tsx scripts/run-local-sql-test.ts h02",
    "test:h02:live": "tsx scripts/verify-h02.ts",
    "h03:setup": "tsx scripts/configure-h03.ts",
    "test:h03:sql": "tsx scripts/run-local-sql-test.ts h03",
    "test:h03:live": "tsx scripts/verify-h03.ts",
    "test:h04:sql": "tsx scripts/run-local-sql-test.ts h04",
    "h04:setup": "tsx scripts/configure-h04.ts",
    "test:h04:live": "tsx scripts/verify-h04.ts",
    "test:h05:sql": "tsx scripts/run-local-sql-test.ts h05",
    "h05:setup": "tsx scripts/configure-h05.ts",
    "test:h05:live": "tsx scripts/verify-h05.ts",
    "test:h06:sql": "tsx scripts/run-local-sql-test.ts h06",
    "h06:setup": "tsx scripts/configure-h06.ts",
    "h06:publish:local": "tsx scripts/publish-h06-local.ts",
    "test:h06:live": "tsx scripts/verify-h06.ts",
    "test:h07:sql": "tsx scripts/run-local-sql-test.ts h07",
    "test:h07:live": "tsx scripts/verify-h07.ts",
    "test:h08:sql": "tsx scripts/run-local-sql-test.ts h08",
    "test:h08:live": "tsx scripts/verify-h08.ts",
    "test:automation:capacity": "tsx scripts/verify-automation-capacity.ts",
    "test:digests:capacity": "tsx scripts/verify-digest-capacity.ts",
    "backup:local": "tsx scripts/backup.ts --local",
    "backup:cloud": "tsx scripts/backup.ts --cloud",
    "backup:fetch": "tsx scripts/fetch-backup.ts",
    "restore:local": "tsx scripts/restore-local.ts",
    "test:h08:recovery": "tsx scripts/verify-h08-recovery.ts",
    "ops:check": "tsx scripts/check-operations.ts",
    "check:bundle": "tsx scripts/check-client-bundle.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\" \"tests/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-query": "5.104.2",
    "cfb": "^1.2.2",
    "client-only": "0.0.1",
    "fflate": "^0.8.3",
    "next": "16.4.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tus-js-client": "^4.3.1",
    "write-excel-file": "4.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vite": "7",
    "vitest": "5.0.4"
  }
}
