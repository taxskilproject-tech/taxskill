{
  "name": "tax-skill",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "yarn": "1.22.22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:architecture": "tsx scripts/check-project.ts",
    "verify": "yarn typecheck && yarn lint && yarn check:architecture && yarn test",
    "env:setup": "tsx scripts/configure-public-environment.ts",
    "db:types": "tsx scripts/generate-database-types.ts",
    "db:new": "supabase migration new",
    "db:status": "supabase migration list --linked",
    "db:local:start": "supabase start",
    "db:local:reset": "supabase db reset --local",
    "env:admin": "tsx scripts/configure-admin-environment.ts",
    "auth:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "seed:demo": "tsx scripts/bootstrap-admin.ts --demo",
    "db:lint": "supabase db lint --linked --schema public,private --level error --fail-on error",
    "test:h02:sql": "supabase db query --linked --file supabase/tests/h02-access.sql",
    "test:h02:live": "tsx scripts/verify-h02.ts",
    "check:bundle": "tsx scripts/check-client-bundle.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\" \"tests/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-query": "5.104.2",
    "client-only": "0.0.1",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vite": "7",
    "vitest": "5.0.4"
  }
}
