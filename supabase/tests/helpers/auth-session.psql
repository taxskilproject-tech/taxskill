-- Trusted fixture setup for Docker SQL suites. Production admission only comes from Auth inserts.
create function pg_temp.authenticate(p_claims text,p_local boolean) returns text
language plpgsql as $$
declare v_claims jsonb:=p_claims::jsonb;
begin
  if v_claims->>'role'='authenticated' then
    insert into auth.sessions(id,user_id,aal,created_at,updated_at)
      values((v_claims->>'session_id')::uuid,(v_claims->>'sub')::uuid,'aal1',now(),now())
      on conflict(id) do nothing;
    perform public.h08_access_token_hook(jsonb_build_object('user_id',v_claims->>'sub','authentication_method','password','claims',v_claims));
  end if;
  return set_config('request.jwt.claims',p_claims,p_local);
end $$;
